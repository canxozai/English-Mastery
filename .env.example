# English Mastery - Environment Configuration
# Copy this file to .env and fill in the values

# Server port
PORT=3001

# OpenAI API Key (required for AI features: conversation, writing feedback, content generation)
# Get yours at: https://platform.openai.com/api-keys
# Free tier available with limited usage; paid plans for full access
OPENAI_API_KEY=

# Database path (default: ./data/english-mastery.db)
DB_PATH=./data/english-mastery.db
