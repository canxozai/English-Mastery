{
  "name": "english-mastery",
  "version": "1.0.0",
  "description": "Comprehensive personal English learning system with CEFR assessment, spaced repetition, and adaptive curriculum",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node server/database/seed.js",
    "setup": "npm install && npm run seed"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.0"
  }
}
